# Copy to HTML/.env for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Supabase (required for real persistence; without it the API falls back to
# in-memory seed users that reset on every cold start)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail account used by nodemailer for OTP / verification / reminder emails.
# EMAIL_PASS must be a Google App Password, not the account password.
EMAIL_USER=
EMAIL_PASS=

# Google Gemini key for the patient chatbot (/api/patient-chat)
GEMINI_API_KEY=

# Public origin used to build verification links.
# Leave empty on Vercel to fall back to the deployment's own VERCEL_URL.
BACKEND_PUBLIC_URL=

# Optional: if set, /api/cron/appointment-reminders requires
# "Authorization: Bearer <CRON_SECRET>". Vercel sends this automatically
# when the same value is set as a project environment variable.
CRON_SECRET=

# Local-only: interval for the in-process reminder scan (ms). Ignored on Vercel,
# where the vercel.json cron entry drives the scan instead.
APPOINTMENT_REMINDER_SCAN_MS=300000
