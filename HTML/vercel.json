{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/Landing/landing.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]?path=:path*" },
    { "source": "/register", "destination": "/api/register" },
    { "source": "/login", "destination": "/api/login" },
    { "source": "/verify-otp", "destination": "/api/verify-otp" },
    { "source": "/forgot-password", "destination": "/api/forgot-password" },
    { "source": "/reset-password", "destination": "/api/reset-password" },
    { "source": "/verification-status", "destination": "/api/verification-status" },
    { "source": "/verify-email", "destination": "/api/verify-email" },
    { "source": "/verify-email/:token", "destination": "/api/verify-email/:token" }
  ],
  "crons": [
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 1 * * *"
    }
  ]
}
